BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
DATABASE=chat_social.db
MAX_WARNS=3
REP_COOLDOWN_HOURS=24
FLOOD_MESSAGES=6
FLOOD_WINDOW_SECONDS=8
FLOOD_MUTE_MINUTES=2
XP_PER_MESSAGE=1

# Режим работы: polling (по умолчанию) или webhook
MODE=polling

# --- Только для MODE=webhook ---
# WEBHOOK_URL=https://your-domain.com/telegram
# WEBHOOK_PATH=/telegram
# WEBHOOK_LISTEN=0.0.0.0
# WEBHOOK_PORT=8080
# WEBHOOK_SECRET=random_long_string
